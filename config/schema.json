{
  "$schema": "./schema.meta.json",
  "title": "clawcode config",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "integer", "const": 1 },
    "model": { "type": "string" },
    "endpoint": { "type": "string" },
    "api_key": {
      "type": "string",
      "pattern": "^(env|credential):.+",
      "description": "Secret reference; plaintext rejected."
    },
    "provider": { "type": "object" },
    "providers": { "type": "object" },
    "agent": { "type": "object" },
    "agents": { "type": "object" }
  },
  "additionalProperties": false
}
