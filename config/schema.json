{
  "$schema": "./schema.meta.json",
  "title": "clawcode config",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "integer", "const": 1 },
    "model": { "type": "string" },
    "endpoint": { "type": "string" },
    "api_key": {
      "type": "string",
      "pattern": "^(env|credential):.+",
      "description": "Secret reference; plaintext rejected."
    },
    "provider": { "type": "object" },
    "providers": { "type": "object" },
    "agent": { "type": "object" },
    "agents": { "type": "object" },
    "mcp": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "enabled": { "type": "boolean" },
          "disabled": { "type": "boolean" },
          "command": {
            "anyOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "environment": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "url": { "type": "string" },
          "headers": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "oauth": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
